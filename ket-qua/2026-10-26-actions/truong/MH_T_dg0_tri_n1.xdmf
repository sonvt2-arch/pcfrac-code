<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="https://www.w3.org/2001/XInclude">
  <Domain>
    <Grid Name="mesh" GridType="Uniform">
      <Topology TopologyType="Triangle" NumberOfElements="160000" NodesPerElement="3">
        <DataItem Dimensions="160000 3" NumberType="Int" Format="HDF">MH_T_dg0_tri_n1.h5:/Mesh/mesh/topology</DataItem>
      </Topology>
      <Geometry GeometryType="XY">
        <DataItem Dimensions="80401 2" Format="HDF">MH_T_dg0_tri_n1.h5:/Mesh/mesh/geometry</DataItem>
      </Geometry>
    </Grid>
    <Grid Name="damage" GridType="Collection" CollectionType="Temporal">
      <Grid Name="damage" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="damage" AttributeType="Scalar" Center="Node">
          <DataItem Dimensions="80401 1" Format="HDF">MH_T_dg0_tri_n1.h5:/Function/damage/0</DataItem>
        </Attribute>
      </Grid>
    </Grid>
  </Domain>
</Xdmf>
